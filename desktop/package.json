{
  "name": "abacophy-desktop",
  "version": "1.0.0",
  "description": "ÁbacoPhy escritorio (Electron + motor Go local)",
  "main": "main.js",
  "author": "Prism@.TEC",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack:linux": "electron-builder --linux AppImage deb",
    "pack:win": "electron-builder --win nsis portable",
    "pack:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "tec.prisma.abacophy",
    "productName": "AbacoPhy",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icon.png"],
    "extraResources": [
      { "from": "bin/", "to": "bin", "filter": ["**/*"] }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "maintainer": "Prism@.TEC"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
