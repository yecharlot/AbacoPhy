# Caddy terminates TLS and proxies traffic to the private AbacoPhy container network.
# Set ABACOPHY_DOMAIN in the environment before starting Docker Compose.
{$ABACOPHY_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy abacophy:10000
}
